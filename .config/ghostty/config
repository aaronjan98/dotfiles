# Colour theme follows the system colour-scheme live: set-wallpapers sets the
# gsettings color-scheme (prefer-light/prefer-dark) from the wallpaper's
# luminance, the desktop portal bridges it to the appearance ghostty watches,
# and ghostty swaps themes with no reload. rice-dark reproduces the original
# look (maroon bg + ghostty's default palette); rice-light is the warm paper
# light scheme. Both live in ./themes/ and mirror kitty's colors-*.conf.
theme = light:rice-light,dark:rice-dark
# background-opacity is NOT theme-able (ghostty only honors color keys in theme
# files), and the light:/dark: prefix only works on `theme` — so opacity is one
# global value here, shared by light and dark. Kept at kitty's 0.5 so the light
# scheme reads as transparent glass rather than a near-opaque white pane.
background-opacity = 0.5
keybind = ctrl+shift+o=toggle_background_opacity

cursor-style = block
cursor-style-blink = true
cursor-color = #FF2800
cursor-text = #000000
custom-shader = /home/aj/.config/ghostty/shaders/cursor_smear.glsl

# Notify when a command finishes while the window is unfocused (1.3.0+)
# Works natively via shell integration (OSC 133). For tmux panes, see ~/.bashrc.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 10s
