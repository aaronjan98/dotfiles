#!/usr/bin/env bash
# Hyprland keybind wrapper for sync-machine.sh with toast feedback.
#
# Usage: sync-toast {arrive|leave}
#
# Why this exists: closing the lid suspends wifi mid-push, so the user needs
# visible confirmation that sync-leave finished before walking away. A toast
# on start (replaced on completion) gives that signal without coupling the
# nixos-config sync script to a desktop notification daemon.

set -uo pipefail

mode="${1:?usage: sync-toast arrive|leave}"
case "$mode" in
  arrive|leave) ;;
  *) echo "sync-toast: unknown mode '$mode' (want arrive|leave)" >&2; exit 2 ;;
esac

LOG="/tmp/sync-${mode}.log"
SYNC="/home/aj/nixos-config/scripts/sync-machine.sh"

# Stable per-mode notification id so the success/failure toast replaces the
# "in progress" one instead of stacking. Picked from a small range that's
# unlikely to clash with other notifiers.
case "$mode" in
  arrive) NID=910 ;;
  leave)  NID=911 ;;
esac

notify-send \
  --replace-id="$NID" \
  --icon=emblem-synchronizing \
  "Sync-${mode}" "Running…"

# Capture exit code separately — sync-machine.sh --leave returns 2 to signal
# "dirty repos found" (a warning, not a failure), so we can't use plain if/else.
"$SYNC" "--${mode}" >"$LOG" 2>&1
sync_exit=$?

case "$sync_exit" in
  0)
    if [[ "$mode" == "leave" ]]; then
      msg="$(cat /tmp/sync-leave.status 2>/dev/null || echo "Safe to close lid")"
    else
      msg="Workspace up to date"
    fi
    notify-send \
      --replace-id="$NID" \
      --icon=emblem-default \
      "Sync-${mode} OK" "$msg"
    ;;
  2)
    if [[ "$mode" == "leave" ]]; then
      body="$(cat /tmp/sync-leave.status 2>/dev/null \
        || echo "Some repos have uncommitted changes — see ${LOG}")"
      # expire-time=0 makes the toast persistent so it survives suspend and
      # is still visible after wake, when sync-leave-preflight is the caller.
      notify-send \
        --replace-id="$NID" \
        --icon=dialog-warning \
        --expire-time=0 \
        "Sync-leave: action needed" \
        "$body"
    else
      notify-send \
        --urgency=critical \
        --replace-id="$NID" \
        --icon=dialog-error \
        "Sync-arrive: unexpected exit 2" "See ${LOG}"
      exit "$sync_exit"
    fi
    ;;
  *)
    notify-send \
      --urgency=critical \
      --replace-id="$NID" \
      --icon=dialog-error \
      "Sync-${mode} FAILED" "See ${LOG} — do NOT close lid"
    exit "$sync_exit"
    ;;
esac
